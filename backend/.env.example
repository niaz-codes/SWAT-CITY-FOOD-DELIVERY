# ============================================================
# Swat City Backend - Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env
# ============================================================

NODE_ENV=development
PORT=4000

# Comma separated origins allowed by CORS. Use * only in development.
CORS_ORIGIN=*

# MongoDB connection string. Include your database name in the path.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/swatcity?appName=Cluster0
MONGODB_URI=

# JWT secrets (use long random strings in production)
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=swat-city-backend

# Cloudinary upload credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seeded admin account (created automatically on first boot)
ADMIN_EMAIL=admin@swatcity.pk
ADMIN_PHONE=03001112222
ADMIN_PASSWORD=ChangeMe_Admin_Strong_Pass

# --- Password reset (Brevo SMTP) ---------------------------------------------
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
# SMTP login user (e.g. xxxx@smtp-brevo.com)
BREVO_SMTP_USER=
# SMTP key (xsmtpsib-...)
BREVO_SMTP_PASS=
# Verified sender address in Brevo
BREVO_FROM_EMAIL=admin@swatcity.pk
BREVO_FROM_NAME=Swat City Food Delivery

# --- Public origin ------------------------------------------------------------
# Used to build password-reset links (e.g. https://api.swatcity.pk or http://localhost:4000)
PUBLIC_API_URL=http://localhost:4000

# --- Password reset policy ---------------------------------------------------
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# --- Firebase Cloud Messaging (optional - push notifications) ---------------
# PREFERRED: Paste the entire service account JSON as a single escaped line.
# Alternatively use FIREBASE_SERVICE_ACCOUNT_PATH for local file reads.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Legacy split form (fallback only). Use the blob/path above when possible.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Expo Push Service ------------------------------------------------------
# The mobile app runs in Expo Go, so device tokens are Expo Push tokens and are
# delivered over the Expo Push API (no credentials required). Firebase above is
# only used for any non-Expo (FCM) tokens still in the database.
# Set EXPO_PUSH_ENABLED=false to keep FCM as the only remote transport.
EXPO_PUSH_ENABLED=true
# Only needed when the Expo account has push security / receipts enabled.
EXPO_ACCESS_TOKEN=


# --- Android/iOS App Links ---------------------------------------------------
# Android App Signing / upload SHA-1 fingerprints (comma separated). For SHA-256
# use ANDROID_APP_SHA256; the .well-known/assetlinks.json supports SHA-256.
ANDROID_APP_SHA1=
ANDROID_APP_SHA256=
# Apple Team ID (used for AASA)
IOS_APPLE_TEAM_ID=
# --- Shared payment behaviour -------------------------------------------------
# Where the gateway sends the payer back to, in a BROWSER (not the app deep link).
# Must match the mounted route. Leave blank to derive it from PUBLIC_API_URL.
PAYMENT_RETURN_URL=
# Per-request gateway timeout (ms) and how long a pending online payment stays open.
PAYMENT_GATEWAY_TIMEOUT_MS=20000
PAYMENT_EXPIRY_MINUTES=30

# --- Easypaisa (Mobile Account / MA) -----------------------------------------
# MA debits the payer's Easypaisa wallet directly: no voucher, no redirect.
# NOTE: these are the official integration fields. There is no API key/secret.
# Portal: https://easypay.easypaisa.com.pk/easypay-merchant/faces/pg/site/IntegrationGuides.jsf
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
EASYPAISA_STORE_ID=
# Your EWP (Easypaisa Wallet) account number the debit is booked against.
EASYPAISA_ACCOUNT_NUMBER=
# Leave blank to follow EASYPAISA_ENVIRONMENT; set explicitly to pin a deployment.
EASYPAISA_BASE_URL=
# `staging` (default, safe) or `production`. Production is
# https://easypay.easypaisa.com.pk; staging is https://easypaystg.easypaisa.com.pk
EASYPAISA_ENVIRONMENT=staging

# --- JazzCash (hosted MPAY checkout) ------------------------------------------
# Guide: https://sandbox.jazzcash.com.pk/SandboxDocumentation/v4.2/ApiReferences.html
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
# The merchant integrity salt used for pp_SecureHash (UTF-8 key, ISO-8859-1 data).
JAZZCASH_INTEGRITY_SALT=
# `sandbox` (default, safe) or `production`. Switch to `production` only after the
# merchant is live-approved; `sandbox` is https://sandbox.jazzcash.com.pk
JAZZCASH_ENVIRONMENT=sandbox
JAZZCASH_API_VERSION=2.0
