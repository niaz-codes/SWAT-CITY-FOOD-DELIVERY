# ============================================================
# Swat City Backend - Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env
# ============================================================

NODE_ENV=development
PORT=4000

# Comma separated origins allowed by CORS. Use * only in development.
CORS_ORIGIN=*

# --- Supabase (Postgres + Storage + Auth OTP emails) -------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role (secret) key. SERVER-SIDE ONLY — it bypasses Row Level Security,
# so it must never reach a client bundle.
SUPABASE_SECRET_KEY=
# Public/anon (publishable) key, used by the app for storage reads.
SUPABASE_PUBLISHABLE_KEY=
# Storage bucket where uploaded images/documents are stored.
SUPABASE_STORAGE_BUCKET=swat-city
#
# Email OTP codes (login / registration / password reset) are generated,
# delivered and verified by SUPABASE AUTH using the credentials above — no
# email credentials are needed in this file for them.
#
# REQUIRED in the Supabase dashboard for delivery to actually reach inboxes:
#   1. Authentication -> Emails -> enable "SMTP Settings" and enter the SMTP
#      account below (for Gmail: smtp.gmail.com:587, the full Gmail address and
#      a Google App Password, not the normal account password).
#      The built-in Supabase email service is heavily rate limited and does
#      NOT reach Gmail reliably.
#   2. Authentication -> Emails -> Templates: "Confirm signup" and "Magic Link"
#      must show `{{ .Token }}` (the 6-digit code) and must NOT use
#      `{{ .ConfirmationURL }}`. Every code is single-use, so opening a link
#      burns the code and the typed code fails with "otp_expired".
#   3. Authentication -> URL Configuration: set Site URL to the deployed origin
#      (never leave the localhost default) and allow `swatcity://**`,
#      `<origin>/**` and the Expo web dev origin.
#   4. Set "Email OTP Expiration" to 600 seconds (the backend also enforces 5).
# `npm run auth:config` applies steps 2-4 with a Supabase personal access token.

# JWT secrets (use long random strings in production)
JWT_SECRET=replace-with-a-random-secret-at-least-16-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-16-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=swat-city-backend

# --- Google Sign-In (customer accounts only) -------------------------------
# WEB OAuth client id from Google Cloud Console > APIs & Services > Credentials.
# The same value goes in app.json under expo.extra.googleClientId.
# Leave empty to disable the Google button on the login screen.
GOOGLE_CLIENT_ID=
# Optional comma separated extra client ids also accepted as an ID token
# audience, e.g. the iOS/Android OAuth clients when building a native app.
GOOGLE_ALLOWED_CLIENT_IDS=

# Seeded admin account (created/verified automatically on first boot).
# ADMIN_EMAIL is required. ADMIN_PASSWORD must be at least 20 characters and is
# never logged. Rotate it deliberately with `npm run admin:password`.
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# --- Optional security notices (SMTP) -----------------------------------------
# OTP verification codes are delivered by SUPABASE AUTH (see above) — nothing
# in this file is needed for login/registration/reset codes.
# SMTP below is used ONLY for the "your password was changed" notice.
# Leaving it blank is safe: the notice is skipped silently.
# Gmail example (requires 2-Step Verification + an App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-character Google App Password>
#   SMTP_FROM_EMAIL=you@gmail.com
# Any other SMTP provider (Brevo, Resend, Zoho, ...) works the same way.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Swat City Food Delivery

# --- Public origin ------------------------------------------------------------
# Used to build payment handoff/return URLs (e.g. https://api.swatcity.pk or
# http://localhost:4000)
PUBLIC_API_URL=http://localhost:4000
# Optional target for links inside Supabase Auth emails, e.g. swatcity://auth
# (must also be listed in the project's Redirect URLs). Leave blank: the app
# verifies the typed 6-digit code, and links are a fallback only.
AUTH_EMAIL_REDIRECT_URL=

# --- Expo Push Service ------------------------------------------------------
# The mobile app runs in Expo Go, so device tokens are Expo Push tokens and are
# delivered over the Expo Push API (no credentials required).
# Set EXPO_PUSH_ENABLED=false to disable remote push entirely.
EXPO_PUSH_ENABLED=true
# Only needed when the Expo account has push security / receipts enabled.
EXPO_ACCESS_TOKEN=


# --- Shared payment behaviour -------------------------------------------------
# Where the gateway sends the payer back to, in a BROWSER (not the app deep link).
# Must match the mounted route. Leave blank to derive it from PUBLIC_API_URL.
PAYMENT_RETURN_URL=
# Per-request gateway timeout (ms) and how long a pending online payment stays open.
PAYMENT_GATEWAY_TIMEOUT_MS=20000
PAYMENT_EXPIRY_MINUTES=30

# --- Easypaisa (Mobile Account / MA) -----------------------------------------
# MA debits the payer's Easypaisa wallet directly: no voucher, no redirect.
# NOTE: these are the official integration fields. There is no API key/secret.
# Portal: https://easypay.easypaisa.com.pk/easypay-merchant/faces/pg/site/IntegrationGuides.jsf
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
EASYPAISA_STORE_ID=
# Your EWP (Easypaisa Wallet) account number the debit is booked against.
EASYPAISA_ACCOUNT_NUMBER=
# Leave blank to follow EASYPAISA_ENVIRONMENT; set explicitly to pin a deployment.
EASYPAISA_BASE_URL=
# `staging` (default, safe) or `production`. Production is
# https://easypay.easypaisa.com.pk; staging is https://easypaystg.easypaisa.com.pk
EASYPAISA_ENVIRONMENT=staging

# --- JazzCash (hosted MPAY checkout) ------------------------------------------
# Guide: https://sandbox.jazzcash.com.pk/SandboxDocumentation/v4.2/ApiReferences.html
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
# The merchant integrity salt used for pp_SecureHash (UTF-8 key, ISO-8859-1 data).
JAZZCASH_INTEGRITY_SALT=
# `sandbox` (default, safe) or `production`. Switch to `production` only after the
# merchant is live-approved; `sandbox` is https://sandbox.jazzcash.com.pk
JAZZCASH_ENVIRONMENT=sandbox
JAZZCASH_API_VERSION=2.0

# --- Cloudinary (Image Storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

