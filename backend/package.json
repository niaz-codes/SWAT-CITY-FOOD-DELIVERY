{
  "name": "swat-city-backend",
  "version": "1.0.0",
  "description": "Production backend for Swat City Food Delivery (Express + Supabase/Postgres + Socket.IO)",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "seed": "tsx src/seed.ts",
    "seed:dev": "tsx src/seed-dev.ts",
    "admin:password": "tsx src/scripts/admin-password.ts",
    "auth:config": "tsx src/scripts/supabase-auth-config.ts",
    "db:audit": "tsx src/scripts/db-audit.ts",
    "schema:apply": "tsx src/scripts/apply-schema.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "test:payments": "tsx src/scripts/test-payments.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^10.0.13",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
