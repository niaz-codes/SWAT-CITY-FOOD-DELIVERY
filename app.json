{
  "expo": {
    "name": "Swat City Food Delivery",
    "slug": "swat-city",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F8F7",
    "icon": "./assets/icon.png",
    "scheme": "swatcity",
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E3F3A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 168,
          "resizeMode": "contain"
        }
      ],
      "./plugins/withPushNotifications",
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-notifications",
        {
          "color": "#0E9488",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Swat City Food Delivery to read a photo so admin can verify a rider's documents.",
          "cameraPermission": "Allow Swat City Food Delivery to use the camera to take your partner photo."
        }
      ],
      "./plugins/withGoogleServices"
    ],
    "android": {
      "package": "com.swatcity.delivery",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E3F3A",
        "monochromeImage": "./assets/adaptive-icon.png"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swatcity.delivery",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is shared with the customer while you are delivering, and with admin support, so they can find you.",
        "NSCameraUsageDescription": "Swat City Food Delivery uses the camera to take your partner photo when you register as a rider."
      }
    },
    "extra": {
      "eas": {
        "projectId": "93e97be7-9fd3-4024-8241-be6538a96051"
      },
      "googleClientId": "1019685188122-j2laq0i2v683bt4bu9j9o68ms7npthsq.apps.googleusercontent.com"
    },
    "owner": "niazkhan4371"
  }
}
